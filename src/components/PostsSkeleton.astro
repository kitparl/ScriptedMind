---
import { siteConfig } from '@/data/site.config'

const { count = siteConfig.paginationSize } = Astro.props
---

<section class='grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mt-3' aria-hidden='true'>
	{
		Array.from({ length: count }).map(() => (
			<article class='grid grid-rows-[300px_auto] md:grid-rows-[300px_220px] min-h-full animate-pulse'>
				<div class='rounded-[2px] bg-gray-200 dark:bg-gray-800' />

				<div class='flex flex-col gap-4 py-6 pl-1'>
					<div class='h-7 w-4/5 rounded bg-gray-200 dark:bg-gray-800' />
					<div class='h-4 w-full rounded bg-gray-200 dark:bg-gray-800' />
					<div class='h-4 w-11/12 rounded bg-gray-200 dark:bg-gray-800' />
					<div class='h-4 w-2/3 rounded bg-gray-200 dark:bg-gray-800' />
					<div class='h-5 w-28 rounded bg-gray-200 dark:bg-gray-800 mt-auto' />
				</div>
			</article>
		))
	}
</section>
