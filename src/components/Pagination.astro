---
import ArrowLeft from './icons/ArrowLeft.astro'
import ArrowRight from './icons/ArrowRight.astro'
import PostsSkeleton from './PostsSkeleton.astro'

const { page } = Astro.props
---

<div class='flex gap-5 md:gap-1 justify-around md:justify-end' data-pagination>
	<!-- Previous Button -->
	{
		page.start > 0 && (
			<a
				href={page.url.prev}
				rel='prev'
				aria-label='Previous page'
				class='flex items-center justify-center px-8 md:px-4 h-10 text-base font-medium text-black bg-white border border-gray-300 rounded-lg hover:bg-gray-100 hover:text-gray-700 dark:bg-transparent dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white'
			>
				<ArrowLeft />
			</a>
		)
	}

	<!-- Next Button -->

	{
		page.currentPage < page.lastPage && (
			<a
				href={page.url.next}
				rel='next'
				aria-label='Next page'
				class='flex items-center justify-center px-8 md:px-4 h-10 ml-3 text-base font-medium text-black bg-white border border-gray-300 rounded-lg hover:bg-gray-100 hover:text-gray-700 dark:bg-transparent dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white'
			>
				<ArrowRight />
			</a>
		)
	}
</div>

<template data-posts-skeleton>
	<PostsSkeleton />
</template>

<script>
	// Delegated on document so it survives the view-transition DOM swap.
	document.addEventListener('click', (event) => {
		const link = (event.target as Element).closest('[data-pagination] a')
		if (!link) return

		const grid = document.querySelector('[data-posts-grid]')
		const skeleton = document.querySelector<HTMLTemplateElement>('[data-posts-skeleton]')
		if (!grid || !skeleton) return

		grid.replaceWith(skeleton.content.cloneNode(true))
	})
</script>
